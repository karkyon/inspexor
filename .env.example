# INSPEXOR ローカル開発用環境変数テンプレート
# 実際の値は .env.local にコピーして設定する（.env.local は git管理しない）
# 分類: 非秘密 / INTERNAL / CONFIDENTIAL / RESTRICTED（インフラ・運用設計書 9章 準拠）

# --- アプリ基本 ---
APP_ENV=local
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=info
TZ=UTC
BUSINESS_TIMEZONE=Asia/Tokyo
BILLING_ALGORITHM_VERSION=BILL-2026-09-05
JOB_MAX_ATTEMPTS=5
SIGNED_URL_TTL_SECONDS=600

# --- DB (RESTRICTED) ---
# docker-compose.yml のservice名/ポートと整合させること。ホストportは着手時の棚卸し結果を使用する。
DB_USER=inspexor
DB_PASSWORD=
DB_NAME=inspexor_dev
DB_HOST_PORT=55432
DATABASE_URL=postgresql://inspexor:CHANGE_ME@localhost:55432/inspexor_dev?schema=public

# --- 認証 (RESTRICTED) ---
# 32byte以上のランダム値を設定する
AUTH_SECRET=

# --- Storage / Tasks / Worker (INTERNAL) ---
STORAGE_BUCKET=
TASKS_QUEUE=
WORKER_URL=http://localhost:3001

# --- Gmail連携 (CONFIDENTIAL / RESTRICTED) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- 帳票テンプレート (CONFIDENTIAL) ---
DAILY_TEMPLATE_ID=
INVOICE_DETAIL_TEMPLATE_ID=
INVOICE_COVER_TEMPLATE_ID=

# --- 監視 (CONFIDENTIAL、PII送信0を厳守) ---
SENTRY_DSN=

# CHG-011 請求書の発行元（BILLING_ENABLED=true のときだけ使う。一部の項目だけでも可。未設定は三成興業株式会社の既定値、住所・登録番号・振込先は空）
# INVOICE_ISSUER_JSON={"postalCode":"","address":"","registrationNo":"T0000000000000","bankNote":"○○銀行 ○○支店 普通 0000000"}

# CHG-012 管理者の多要素認証（認証アプリの確認コード）。'true' のときだけ有効。本番はお客様の合意後に有効にする
# ADMIN_MFA_ENABLED=true
