# INSPEXOR 開発用の設定（CHG-006 以降: データベースは Firestore）
#   使い方: cp .env.example apps/web/.env.local して値を入れる（.env.local は git に入れない）
#   web（Next.js）は apps/web/.env.local を読み、worker は `npx tsx --env-file=../web/.env.local src/index.ts` で同じファイルを読む
#   本番の値は scripts/gcp/deploy-prod.sh が Cloud Run に設定する（AUTH_SECRET は Secret Manager）。このファイルは本番では使わない

# --- 基本 ---
# local | dev | stg | prod（prod のときだけ、試験データのスクリプトに --prod が必要）
APP_ENV=dev
# 32 文字以上のランダム値（例: openssl rand -base64 48）。漏れたら作り直す
AUTH_SECRET=

# --- Firestore・Cloud Storage ---
# 開発用プロジェクト（Cloud Shell では gcloud の認証情報で接続）
FIRESTORE_PROJECT_ID=inspexor-jadeworks-dev
# FIRESTORE_DATABASE_ID=(default)
# 結合試験はエミュレータ（scripts/firestore/start-emulator.sh、127.0.0.1:8085）。試験のコマンドで指定するのでここには書かない
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# PDF の保存先。未設定ならローカルディスク（STORAGE_DIR、既定 ~/.inspexor-storage）
STORAGE_BUCKET=
# STORAGE_DIR=
# gcloud のクォータを請求するプロジェクト（Cloud Shell の既定プロジェクトと違うときに必要）
GOOGLE_CLOUD_QUOTA_PROJECT=inspexor-jadeworks-dev

# --- worker（帳票の作成・メール） ---
# 開発は常駐（poll）で、この間隔（ミリ秒）ごとに処理する。本番は WORKER_MODE=http（Cloud Scheduler が毎分起動）
WORKER_POLL_MS=2000
# WORKER_MODE=poll
# 確定直後に worker を起こす URL（本番のみ。未設定なら起こさず poll を待つ）
# WORKER_URL=
# PDF 化に使う Chromium（未設定なら Playwright の既定）
# CHROMIUM_PATH=
# 開発用メール（Mailpit: docker compose up -d mailpit）
# MAILPIT_URL=http://127.0.0.1:8025
# MAIL_FROM=inspexor-dev@example.invalid

# --- 機能の切り替え（'true' のときだけ有効）---
# 本番は提案書（SK-2026-08-MINI）の範囲だけにするため、4 つとも無効のまま。お客様の判断で有効にする
# 開発では batch が APPROVAL_ENABLED・BILLING_ENABLED・ADMIN_MFA_ENABLED を true にして E2E を流す
# CHG-007 承認ワークフロー・管理ダッシュボード
APPROVAL_ENABLED=false
# CHG-009/011 請求計算・請求書の発行と送付
BILLING_ENABLED=false
# CHG-012 管理者の多要素認証（認証アプリの確認コード）
ADMIN_MFA_ENABLED=false
# CHG-004 日報メールの自動送信
DAILY_MAIL_ENABLED=false

# CHG-011 請求書の発行元（BILLING_ENABLED=true のときだけ使う。一部の項目だけでも可。未設定は三成興業株式会社の既定値、住所・登録番号・振込先は空）
# INVOICE_ISSUER_JSON={"postalCode":"","address":"","registrationNo":"T0000000000000","bankNote":"○○銀行 ○○支店 普通 0000000"}
