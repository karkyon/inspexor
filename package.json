{
  "name": "inspexor",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "22.x",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @inspexor/web dev",
    "dev:worker": "pnpm --filter @inspexor/worker dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @inspexor/db test:integration",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "contract:check": "pnpm --filter @inspexor/contracts check",
    "migration:check": "pnpm --filter @inspexor/db migration:check",
    "ports:audit": "bash scripts/audit-ports.sh",
    "db:up": "docker compose -p inspexor-dev up -d db",
    "db:down": "docker compose -p inspexor-dev down",
    "db:migrate": "pnpm --filter @inspexor/db prisma:migrate",
    "db:generate": "pnpm --filter @inspexor/db prisma:generate",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
